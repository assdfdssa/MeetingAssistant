{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MeetingAssistant",
  "version": "0.4.1",
  "identifier": "local.classcatch.meetingassistant",
  "build": {
    "frontendDist": "../.next-production",
    "devUrl": "http://localhost:3118",
    "beforeDevCommand": "node node_modules/next/dist/bin/next dev -p 3118",
    "beforeBuildCommand": "node scripts/build-classroom.cjs"
  },
  "app": {
    "windows": [
      {
        "title": "课堂补听 · MeetingAssistant",
        "width": 1280,
        "height": 860,
        "resizable": true,
        "fullscreen": false,
        "theme": "Light",
        "decorations": true,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": {
        "default-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: https://asset.localhost data:",
        "connect-src": "'self' http://localhost:11434 http://localhost:5167 http://localhost:8178 https://api.ollama.ai",
        "media-src": "'self' asset: http://asset.localhost https://asset.localhost blob:"
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "G:/MeetingAssistant/data/**"
        ]
      },
      "capabilities": [
        {
          "identifier": "main",
          "description": "Main window capability with file system and media access",
          "windows": [
            "main",
            "catchup"
          ],
          "permissions": [
            "fs:default",
            "fs:allow-read-file",
            "fs:read-all",
            "fs:write-all",
            "fs:allow-app-read",
            "fs:allow-app-write",
            "fs:allow-download-write",
            "fs:allow-download-read",
            "fs:scope-download",
            "core:path:default",
            "core:event:default",
            "core:window:default",
            "core:app:default",
            "core:resources:default",
            "core:menu:default",
            "core:tray:default",
            "core:window:allow-set-title",
            "store:default",
            "notification:default",
            "notification:allow-is-permission-granted",
            "process:default",
            {
              "identifier": "fs:scope",
              "allow": [
                {
                  "path": "$APPDATA/*"
                }
              ]
            }
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/icon.png",
      "icons/app_icon.icns",
      "icons/app_icon.ico"
    ],
    "resources": [
      "templates/*.json"
    ],
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/llama-helper"
    ],
    "macOS": {
      "entitlements": "entitlements.plist",
      "signingIdentity": "-",
      "hardenedRuntime": true
    }
  },
  "plugins": {}
}
